# Mandol independent deployment. Copy to .env; never commit .env.
# Models and web calls need your own services/credentials. No bundled default account.
DEEPSEEK_API_KEY=
CHINASOFT_SEARCH_ENABLED=false
CHINASOFT_HOST=127.0.0.1
CHINASOFT_QDRANT_URL=http://127.0.0.1:20633
CHINASOFT_QDRANT_COLLECTION=chinasoft_opensource_memory_v1
CHINASOFT_LLM_BASE_URL=https://api.deepseek.com/v1
CHINASOFT_LLM_MODEL=deepseek-flash
CHINASOFT_LLM_REQUEST_MODEL=deepseek-flash
CHINASOFT_VLM_MODEL=deepseek-flash
CHINASOFT_VLM_REQUEST_MODEL=deepseek-flash
CHINASOFT_LLM_ACCEPTED_RESPONSE_MODELS=deepseek-flash
CHINASOFT_VLM_ACCEPTED_RESPONSE_MODELS=deepseek-flash
CHINASOFT_EMBEDDING_BASE_URL=http://127.0.0.1:20631/v1
CHINASOFT_RERANKER_BASE_URL=http://127.0.0.1:20632
CHINASOFT_SPLADE_URL=http://127.0.0.1:20636
CHINASOFT_MEMORY_QUERY_STRATEGY=adaptive_v33
CHINASOFT_REPOSITORY_ROOTS=
CHINASOFT_PORT=20600
CHINASOFT_DATA_DIR=data/native
CHINASOFT_ALLOW_RETRIEVAL_DEGRADED=false
CHINASOFT_REGISTRATION_ENABLED=false
CHINASOFT_REGISTRATION_APPROVAL=true
CHINASOFT_DEMO_ENABLED=false

# Dedicated Compose project and ports
MANDOL_COMPOSE_PROJECT=mandol-os-native
MANDOL_QDRANT_PORT=20633
# Only for the container application: use host-gateway or independent remote origins.
CHINASOFT_CONTAINER_DENSE_URL=http://host.docker.internal:20631/v1
CHINASOFT_CONTAINER_SPARSE_URL=http://host.docker.internal:20636
CHINASOFT_CONTAINER_RERANKER_URL=http://host.docker.internal:20632

# Optional explicit local GPU deployment; normal start.sh never starts these.
CHINASOFT_MODEL_CACHE=data/models/hub
CHINASOFT_DENSE_MANAGED=false
CHINASOFT_DENSE_GPU=0
CHINASOFT_SPARSE_MANAGED=false
CHINASOFT_SPARSE_GPU=0
CHINASOFT_RERANKER_MANAGED=false
CHINASOFT_RERANKER_GPU=0

# Additional supported Settings (uncomment only when needed; see docs/CONFIGURATION.md)
# CHINASOFT_LLM_API_KEY_ENV  # llm_api_key_env; default 'DEEPSEEK_API_KEY'
# CHINASOFT_LLM_TIMEOUT  # llm_timeout; default 90
# CHINASOFT_LLM_MAX_CONCURRENCY  # llm_max_concurrency; default 2
# CHINASOFT_LLM_MAX_TOKENS  # llm_max_tokens; default 4096
# CHINASOFT_JSON_OUTPUT_MODE  # json_output_mode; default 'json_object'
# CHINASOFT_GENERATION_RETRY_POLICY  # generation_retry_policy; default 3
# CHINASOFT_REASONING_PROTOCOL  # reasoning_protocol; default 'auto'
# CHINASOFT_SEARCH_BASE_URL  # search_base_url; default 'https://api.deepseek.com/v1'
# CHINASOFT_SEARCH_API_KEY_ENV  # search_api_key_env; default 'DEEPSEEK_API_KEY'
# CHINASOFT_SEARCH_TIMEOUT  # search_timeout; default 12
# CHINASOFT_SEARCH_MAX_QUERIES  # search_max_queries; default 2
# CHINASOFT_SEARCH_PLANNER_ENABLED  # search_planner_enabled; default 'true'
# CHINASOFT_SEARCH_PLANNER_TIMEOUT  # search_planner_timeout; default 4
# CHINASOFT_SEARCH_MAX_RESULTS  # search_max_results; default 5
# CHINASOFT_SEARCH_MAX_FETCH  # search_max_fetch; default 0
# CHINASOFT_SEARCH_CONTEXT_CHARS  # search_context_chars; default 10000
# CHINASOFT_SEARCH_FETCH_HOSTS  # search_fetch_hosts; default 'api-docs.deepseek.com,docs.python.org'
# CHINASOFT_WEB_REQUESTS_PER_DAY  # web_requests_per_day; default 1000
# CHINASOFT_WEB_WORKSPACE_PER_DAY  # web_workspace_per_day; default 100
# CHINASOFT_RETRIEVAL_BACKEND  # retrieval_backend; default 'vllm'
# CHINASOFT_EMBEDDING_API_KEY_ENV  # embedding_api_key_env; default ''
# CHINASOFT_EMBEDDING_MODEL  # embedding_model; default 'Qwen/Qwen3-Embedding-0.6B'
# CHINASOFT_EMBEDDING_DIMENSION  # embedding_dimension; default 1024
# CHINASOFT_RERANKER_API_KEY_ENV  # reranker_api_key_env; default ''
# CHINASOFT_RERANKER_MODEL  # reranker_model; default 'BAAI/bge-reranker-v2-m3'
# CHINASOFT_SPLADE_API_KEY_ENV  # sparse_api_key_env; default ''
# CHINASOFT_DENSE_TIMEOUT  # dense_timeout; default 30
# CHINASOFT_SPARSE_TIMEOUT  # sparse_timeout; default 30
# CHINASOFT_RERANKER_TIMEOUT  # reranker_timeout; default 30
# CHINASOFT_DENSE_CONCURRENCY  # dense_concurrency; default 2
# CHINASOFT_SPARSE_CONCURRENCY  # sparse_concurrency; default 2
# CHINASOFT_RERANKER_CONCURRENCY  # reranker_concurrency; default 2
# CHINASOFT_CHAT_HISTORY_CHARS  # chat_history_chars; default '16000'
# CHINASOFT_CHAT_ATTACHMENT_CHARS  # chat_attachment_chars; default '16000'
# CHINASOFT_ATTACHMENT_MAX_BYTES  # attachment_max_bytes; default '262144'
# CHINASOFT_ATTACHMENT_MAX_FILES  # attachment_max_files; default '4'
# CHINASOFT_QUEUE_CAPACITY  # queue_capacity; default 192
# CHINASOFT_WORKER_MAX_ATTEMPTS  # worker_max_attempts; default 3
# CHINASOFT_SECURE_COOKIE  # secure_cookie; default 'false'
# CHINASOFT_SESSION_TTL  # session_ttl; default 604800
# CHINASOFT_ACCOUNT_JOB_QUOTA  # account_job_quota; default 96
# CHINASOFT_MAX_ACCOUNTS  # max_accounts; default 100
# CHINASOFT_QUOTA_WORKSPACES  # quota_workspaces; default 10
# CHINASOFT_QUOTA_CONVERSATIONS  # quota_conversations; default 300
# CHINASOFT_QUOTA_REPOSITORIES  # quota_repositories; default 5
# CHINASOFT_QUOTA_STORAGE_BYTES  # quota_storage_bytes; default 100 * 1024 * 1024
# CHINASOFT_QUOTA_CHAT_PER_MINUTE  # quota_chat_per_minute; default 10
# CHINASOFT_QUOTA_MODEL_PER_DAY  # quota_model_per_day; default 300
# CHINASOFT_MODEL_REQUESTS_PER_DAY  # model_requests_per_day; default 2000
# CHINASOFT_REMOTE_GIT_ENABLED  # remote_git_enabled; default 'true'
# CHINASOFT_REMOTE_GIT_MAX_FILES  # remote_git_max_files; default 500
# CHINASOFT_REMOTE_GIT_MAX_BYTES  # remote_git_max_bytes; default 20 * 1024 * 1024
# CHINASOFT_REMOTE_GIT_TIMEOUT  # remote_git_timeout; default 180
# CHINASOFT_REMOTE_GIT_CACHE_BYTES  # remote_git_cache_bytes; default 256 * 1024 * 1024
# CHINASOFT_REPOSITORY_EXCLUDES  # repository_excludes; default '.release-private/*'
# CHINASOFT_REPOSITORY_MAX_FILES  # repository_max_files; default 2500
# CHINASOFT_REPOSITORY_MAX_FILE_BYTES  # repository_max_file_bytes; default 256 * 1024
# CHINASOFT_REPOSITORY_MAX_TOTAL_BYTES  # repository_max_total_bytes; default 12 * 1024 * 1024
# CHINASOFT_REPOSITORY_MAX_CHUNKS  # repository_max_chunks; default 6000
# CHINASOFT_DENSE_GPU_MEMORY=  # see docs/INFERENCE.md
# CHINASOFT_DENSE_MAX_SEQS=  # see docs/INFERENCE.md
# CHINASOFT_DENSE_MAX_BATCHED_TOKENS=  # see docs/INFERENCE.md
# CHINASOFT_DENSE_VLLM_PYTHON=  # see docs/INFERENCE.md
# CHINASOFT_SPARSE_GPU_MEMORY=  # see docs/INFERENCE.md
# CHINASOFT_SPARSE_MAX_SEQS=  # see docs/INFERENCE.md
# CHINASOFT_SPARSE_MAX_BATCHED_TOKENS=  # see docs/INFERENCE.md
# CHINASOFT_SPARSE_VLLM_PYTHON=  # see docs/INFERENCE.md
# CHINASOFT_RERANKER_GPU_MEMORY=  # see docs/INFERENCE.md
# CHINASOFT_RERANKER_MAX_SEQS=  # see docs/INFERENCE.md
# CHINASOFT_RERANKER_MAX_BATCHED_TOKENS=  # see docs/INFERENCE.md
# CHINASOFT_RERANKER_VLLM_PYTHON=  # see docs/INFERENCE.md
# CHINASOFT_STUDIO_DIST=studio/dist  # compiled frontend, default repository studio/dist
# CHINASOFT_APP_ROOT=  # usually leave unset; container uses /app
